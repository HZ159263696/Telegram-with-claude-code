<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_label_url"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/input_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_hint_url"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary"
            android:padding="12dp"
            android:background="@drawable/edit_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="start">

            <Button
                android:id="@+id/btn_lan"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_lan_preset"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_ngrok"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_ngrok_preset"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="20dp"
            android:padding="14dp"
            android:background="@drawable/hint_bg" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_save"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
